# Copy this file to .env.local for local development.
# Never commit real secret values. Rotate any value that was previously pushed.

# Browser-exposed Vite variables. These are available in frontend bundles.
VITE_APP_ENV=production
VITE_SUPABASE_URL=TODO_ROTATE_SUPABASE_PROJECT_URL
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=TODO_ROTATE_SUPABASE_PUBLISHABLE_DEFAULT_KEY

# Server-only variables. Do not prefix secret values with VITE_.
APP_ENV=production
DEMO_RESET_ENABLED=false
DEMO_AUTH_USERS_JSON=[{"userId":"00000000-0000-0000-0000-000000000000","name":"Demo Admin","email":"demo-admin@example.com","roles":["admin","brother","treasurer"]}]
SUPABASE_SERVICE_ROLE_KEY=TODO_ROTATE_SUPABASE_SERVICE_ROLE_KEY
